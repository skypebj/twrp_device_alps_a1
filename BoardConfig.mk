DEVICE_PATH := device/alps/a1

# Architecture
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_ABI2 :=
TARGET_CPU_VARIANT := cortex-a53

TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv8-a
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_2ND_CPU_VARIANT := generic

# Bootloader / Kernel
TARGET_NO_KERNEL := false
TARGET_NO_RECOVERY := true
BOARD_USES_GENERIC_KERNEL_IMAGE := true
BOARD_KERNEL_PAGESIZE := 2048
BOARD_BOOT_HEADER_VERSION := 3
BOARD_KERNEL_IMAGE_NAME := kernel
BOARD_RAMDISK_USE_LZ4 := true
TARGET_PREBUILT_DTB := $(DEVICE_PATH)/prebuilt/dtb

# Partitions / Dynamic Partitions (VAB)
BOARD_SUPER_PARTITION_SIZE := 9126805504
BOARD_SUPER_PARTITION_GROUPS := main
BOARD_MAIN_SIZE := 9122611200
BOARD_MAIN_PARTITION_LIST := system vendor product
BOARD_FLASH_BLOCK_SIZE := 131072

# A/B & Virtual A/B
AB_OTA_UPDATER := true
AB_OTA_PARTITIONS += \
    boot \
    vendor_boot \
    dtbo \
    vbmeta \
    vbmeta_system \
    vbmeta_vendor
BOARD_USES_RECOVERY_AS_BOOT := false
BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT := true

# Storage & Encryption
BOARD_USES_METADATA_PARTITION := true
BOARD_ROOT_EXTRA_FOLDERS := metadata

# Display / TWRP GUI Flags
TW_THEME := portrait_hd_screen
TW_SCREEN_BLANK_ON_BOOT := true
TARGET_SCREEN_WIDTH := 1200
TARGET_SCREEN_HEIGHT := 2000
TW_ROTATION := 2
TW_STATUS_ICONS_ALIGN := center

# TWRP Specific Options
TW_DEVICE_VERSION := 1.0
TW_INCLUDE_CRYPTO := false
TW_INCLUDE_FBE_METADATA_DECRYPT := true
TW_EXTRA_LANGUAGES := true
TW_MAX_BRIGHTNESS := 255
TW_DEFAULT_BRIGHTNESS := 150
TW_HAS_MTP := true
TW_USE_TOOLBOX := true
TW_EXCLUDE_APEX := true
TW_EXCLUDE_DEFAULT_USB_INIT := true

# Allow missing dependencies for minimal build
ALLOW_MISSING_DEPENDENCIES := true
TW_DEVICE_VERSION := 12.1
TW_THEME := portrait_hdpi
# 禁用构建期 SELinux 强校验，避免缺少策略文件导致打包中断
BOARD_SEPOLICY_DIRS :=
BOARD_PLAT_PRIVATE_SEPOLICY_DIR :=
BOARD_PLAT_PUBLIC_SEPOLICY_DIR :=

# 确保跳过标准内核打包并只专注于 vendor_boot
BOARD_KERNEL_IMAGE_NAME := kernel
TARGET_NO_KERNEL := false
BOARD_USES_RECOVERY_AS_BOOT := false
BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT := true
